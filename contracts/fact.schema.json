{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platformforge/fact/v1",
  "title": "PlatformForge Fact",
  "type": "object",
  "required": ["fact_id", "kind", "source", "location", "observed", "tier"],
  "properties": {
    "fact_id": {"type": "string", "pattern": "^PF-[A-Z0-9]+-[0-9]+$"},
    "kind": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "location": {"type": "string", "minLength": 1},
    "observed": {"type": "boolean"},
    "tier": {"type": "integer", "minimum": 0, "maximum": 7},
    "attrs": {"type": "object", "additionalProperties": true},
    "measures": {"type": "object", "additionalProperties": {"type": ["number", "string", "boolean", "null"]}},
    "provenance": {
      "type": "object",
      "properties": {
        "tool": {"type": "string"},
        "tool_version": {"type": "string"},
        "extracted_at": {"type": "string"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "freshness": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "enum": ["current", "fresh", "stale", "deprecated", "superseded", "conflicted", "unresolved"]},
        "valid_from": {"type": ["string", "null"]},
        "valid_until": {"type": ["string", "null"]}
      }
    }
  },
  "additionalProperties": false
}
