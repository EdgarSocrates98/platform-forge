{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platformforge/collector-receipt/v1",
  "title": "PlatformForge Collector Receipt",
  "type": "object",
  "required": ["schema", "collector", "collector_version", "provider",
               "started_at", "scope"],
  "properties": {
    "schema": {"const": "platformforge/collector-receipt/v1"},
    "collector": {"type": "string", "minLength": 1},
    "collector_version": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "started_at": {"type": "string"},
    "completed_at": {"type": "string"},
    "scope": {"type": "object"},
    "api_calls": {"type": "integer"},
    "pages": {"type": "integer"},
    "objects": {"type": "integer"},
    "bytes": {"type": "integer"},
    "throttles": {"type": "integer"},
    "retries": {"type": "integer"},
    "cache_hits": {"type": "integer"},
    "errors": {"type": "array", "items": {"type": "string"}},
    "permission_denied": {"type": "array"},
    "unsupported": {"type": "array"},
    "cursor": {"type": "string"},
    "metadata_only": {"type": "boolean"},
    "fallback": {"type": "string"},
    "coverage": {"type": "object"},
    "freshness": {"type": "object"},
    "budget_outcome": {"enum": ["complete", "reduced_scope", "sampled",
                                "refused"]},
    "duration_s": {"type": "number"}
  },
  "additionalProperties": true
}
