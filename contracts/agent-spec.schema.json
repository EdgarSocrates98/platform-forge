{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platformforge/agent-spec/v1",
  "title": "PlatformForge canonical agent contract (cycle5.1)",
  "type": "object",
  "required": ["schema", "name", "role", "domains", "when_to_enter",
               "when_not_to_enter", "access", "write_scope",
               "model_tier", "never"],
  "properties": {
    "schema": {"const": "platformforge/agent-spec/v1"},
    "name": {"type": "string", "pattern": "^(platform|pf)-[a-z0-9-]+$"},
    "role": {"type": "string", "enum": ["orchestrator", "planner",
             "coordinator", "specialist", "executor", "reviewer",
             "critic", "referee", "verifier", "guardian"]},
    "domains": {"type": "array", "items": {"type": "string"}},
    "mission": {"type": "string"},
    "when_to_enter": {"type": "string", "minLength": 1},
    "when_not_to_enter": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "required_evidence": {"type": "array", "items": {"type": "string"}},
    "allowed_verbs": {"type": "array", "items": {"type": "string"}},
    "allowed_tools": {"type": "array", "items": {"type": "string"}},
    "allowed_capabilities": {"type": "array", "items": {"type": "string"}},
    "access": {"type": "string", "enum": ["read-only", "state-writer",
               "workspace-writer", "governed-writer"]},
    "write_scope": {"type": "string", "enum": ["none", "runs",
                "artifacts", "governed"]},
    "model_tier": {"type": "string", "enum": ["deterministic", "fast",
                   "standard", "deep", "critical-review"]},
    "max_context_budget": {"type": "integer", "minimum": 0},
    "max_tool_calls": {"type": "integer", "minimum": 0},
    "max_parallelism": {"type": "integer", "minimum": 1},
    "delegates_to": {"type": "array", "items": {"type": "string"}},
    "cannot_delegate_to": {"type": "array", "items": {"type": "string"}},
    "reviewers": {"type": "array", "items": {"type": "string"}},
    "verifier": {"type": "string"},
    "escalation": {"type": "string"},
    "done_when": {"type": "string"},
    "never": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
