{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platformforge/task-spec/v1",
  "title": "PlatformForge TaskSpec — sealed task for orchestration",
  "type": "object",
  "required": ["schema", "task_id", "intent", "state"],
  "properties": {
    "schema": {"const": "platformforge/task-spec/v1"},
    "task_id": {"type": "string", "minLength": 1},
    "intent": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "enum": ["repo", "fleet", "runtime",
              "change"]},
    "domains": {"type": "array", "items": {"type": "string"}},
    "risk": {"type": "string", "enum": ["low", "medium", "high",
             "critical"]},
    "complexity": {"type": "string", "enum": ["low", "medium", "high"]},
    "evidence_requirements": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "autonomy": {"type": "string", "enum": ["read-only", "propose",
                 "simulate"]},
    "allowed_capabilities": {"type": "array", "items": {"type": "string"}},
    "forbidden_capabilities": {"type": "array",
                               "items": {"type": "string"}},
    "rollback_requirement": {"type": "string", "enum": ["none",
                             "declared", "material-bound"]},
    "verification_requirement": {"type": "string"},
    "budget": {"type": "string", "enum": ["tiny", "small", "standard",
               "deep", "critical"]},
    "state": {"type": "string", "enum": ["draft", "reviewed", "sealed",
              "rejected", "expired"]},
    "reviewer": {"type": "string"},
    "review_notes": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string"},
    "spec_hash": {"type": "string"}
  },
  "additionalProperties": false
}
