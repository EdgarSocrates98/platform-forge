{
  "forge_id": "platform-forge",
  "package": "platformforge",
  "distribution": "platformforge",
  "cli": "platformforge",
  "python": ">=3.10",
  "mcp_server_name": "platformforge",
  "mcp_command": [
    "platformforge-mcp"
  ],
  "extras": [
    "mcp"
  ],
  "lab": {
    "command": [
      "{checkout}/.venv/bin/python",
      "scripts/lab/platformforge_lab.py",
      "--checkout",
      "{checkout}",
      "--mode",
      "{mode}",
      "--result-out",
      "{receipt}"
    ],
    "receipt": ".forge/lab-result.json",
    "modes": [
      "A"
    ],
    "suite": "platform-forge-lab",
    "timeout_s": 300
  }
}
