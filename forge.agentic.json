    "pf-synthesizer",
    "pf-verifier",
    "platform-adversarial-critic",
    "platform-ai-infra-specialist",
    "platform-architecture-reviewer",
    "platform-aws-specialist",
    "platform-capacity-specialist",
    "platform-change-coordinator",
    "platform-crossplane-specialist",
    "platform-debate-referee",
    "platform-economy-reviewer",
    "platform-evidence-reviewer",
    "platform-federation-specialist",
    "platform-finops-specialist",
    "platform-fleet-coordinator",
    "platform-fleet-specialist",
    "platform-gitops-specialist",
    "platform-graph-specialist",
    "platform-iac-specialist",
    "platform-incident-coordinator",
    "platform-kubernetes-specialist",
    "platform-operations-safety-reviewer",
    "platform-optimization-coordinator",
    "platform-orchestrator",
    "platform-planner",
    "platform-policy-specialist",
    "platform-privacy-reviewer",
    "platform-product-coordinator",
    "platform-product-specialist",
