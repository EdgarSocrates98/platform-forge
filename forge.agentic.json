{
  "schema": "forge/SpecialistAgenticManifest/v1",
  "provider": "platform-forge",
  "version": "0.1.0",
  "cli": "platformforge",
  "cli_entry": "platformforge.cli.main:main",
  "workflows": [
    {
      "id": "analyze",
      "mode": "DIRECT_CAPABILITY",
      "command": [
        "{cli}",
        "analyze",
        "{target}"
      ],
      "description": "Analyze platform/IaC surfaces",
      "read_only": true
    },
    {
      "id": "doctor",
      "mode": "DIAGNOSTIC_ONLY",
      "command": [
        "{cli}",
        "doctor"
      ],
      "description": "Environment health",
      "read_only": true
    }
  ],
  "skills": [],
  "agents": [],
  "coordinators": [],
  "mcp_command": [
    "platformforge-mcp"
  ],
  "host_adapters": [
    "claude",
    "devin",
    "codex",
    "copilot"
  ],
  "requires_network": false,
  "requires_credentials": false,
  "read_only_default": true
}
