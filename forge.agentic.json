      "description": "Analyze platform/IaC surfaces",
      "read_only": true
    },
    {
      "id": "doctor",
      "mode": "DIAGNOSTIC_ONLY",
      "command": [
        "{cli}",
        "doctor"
      ],
      "description": "Environment health",
      "read_only": true
    }
  ],
