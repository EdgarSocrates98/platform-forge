{
  "schema": "forge/SpecialistAgenticManifest/v1",
  "provider": "platform-forge",
  "version": "0.3.3",
  "cli": "platformforge",
  "cli_entry": "platformforge.cli.main:main",
  "workflows": [
    {
      "id": "analyze",
      "mode": "DIRECT_CAPABILITY",
